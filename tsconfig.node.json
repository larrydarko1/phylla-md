{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        /* Output & Build */
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "noEmit": true,

        /* Target & Environment */
        "target": "ES2025",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2025"],

        /* Paths & Types */
        "paths": {
            "@/main/*": ["./src/main/*"],
            "@/preload/*": ["./src/preload/*"],
            "@/schemas/*": ["./src/schemas/*"]
        },
        "types": ["node"],

        /* Module System — the Vite config files are bundler-resolved and may
           import sibling `.ts` files by their real extension. */
        "allowImportingTsExtensions": true,
        "moduleDetection": "force"
    },
    "include": [
        "electron.vite.config.ts",
        "vitest.config.ts",
        "larry.config.ts",
        "vitest.setup.ts",
        "src/main/**/*.ts",
        "src/preload/**/*.ts"
    ]
}
