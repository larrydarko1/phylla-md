{
    "name": "phylla-md",
    "version": "3.1.0",
    "description": "A local-first, privacy-focused note-taking app for desktop with built-in AI assistance. Simple interface for reading and editing txt and md files, plus support for loading local LLMs (GGUF format) for private, on-device chat and assistance. All notes and AI interactions stay on your device.",
    "keywords": [
        "notes",
        "markdown",
        "electron",
        "local-ai",
        "llm",
        "privacy"
    ],
    "homepage": "https://github.com/larrydarko1/phylla-md#readme",
    "bugs": {
        "url": "https://github.com/larrydarko1/phylla-md/issues"
    },
    "license": "AGPL-3.0-only",
    "author": {
        "name": "Lorenzo Mazzola",
        "email": "hello@larrydarko.dev"
    },
    "type": "module",
    "main": "out/main/index.js",
    "desktopName": "phylla.desktop",
    "repository": {
        "type": "git",
        "url": "https://github.com/larrydarko1/phylla-md.git"
    },
    "scripts": {
        "predev": "install-electron",
        "dev": "electron-vite dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc -b tsconfig.json",
        "build": "npm run typecheck && electron-vite build",
        "build:electron": "npm run build && electron-builder",
        "build:mac": "npm run build && electron-builder --mac --publish never",
        "build:win": "npm run build && electron-builder --win --publish never",
        "build:linux": "npm run build && electron-builder --linux --publish never",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json}\"",
        "audit:check": "node scripts/check/check-audit.ts",
        "code:check": "node scripts/check/check-code-style.ts",
        "dead:check": "node scripts/check/check-dead-code.ts",
        "declorder:check": "node scripts/check/check-declaration-order.ts",
        "dup:check": "node scripts/check/check-duplication.ts",
        "error:check": "node scripts/check/check-error-handling.ts",
        "html:check": "node scripts/check/check-html-standards.ts",
        "i18n:check": "node scripts/check/check-i18n.ts",
        "ipc:check": "node scripts/check/check-ipc-standards.ts",
        "pipeline:check": "node scripts/check/check-pipeline.ts",
        "pkg:check": "node scripts/check/check-package-json.ts",
        "refactor:check": "node scripts/check/check-refactoring.ts",
        "scss:check": "node scripts/check/check-scss-standards.ts",
        "security:check": "node scripts/check/check-electron-security.ts",
        "test:check": "node scripts/check/check-testing.ts",
        "tsconfig:check": "node scripts/check/check-tsconfigs.ts",
        "stylelint": "stylelint \"src/**/*.{scss,vue}\"",
        "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
        "prepare": "husky",
        "test:coverage": "npx vitest run --coverage",
        "ci:check": "npm run audit:check && npm run lint && npm run format:check && npm run stylelint && npm run pkg:check && npm run pipeline:check && npm run code:check && npm run declorder:check && npm run html:check && npm run scss:check && npm run refactor:check && npm run ipc:check && npm run security:check && npm run error:check && npm run dup:check && npm run dead:check && npm run i18n:check && npm run tsconfig:check && npm run test:coverage && npm run test:check && npm run build"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.12.4",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.13",
        "@huggingface/transformers": "^4.2.0",
        "@lezer/highlight": "^1.2.5",
        "dompurify": "^3.4.16",
        "electron-log": "^5.4.4",
        "marked": "^18.0.14",
        "node-llama-cpp": "^3.22.1",
        "onnxruntime-node": "^1.24.2",
        "vue": "^3.5.43",
        "vue-i18n": "^11.4.12",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@larrydarko/lint-config": "^0.1.0-beta.9",
        "@types/node": "^24.0.13",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.2",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.0",
        "electron": "^43.4.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "jsdom": "^30.1.1",
        "sass-embedded": "^1.105.0",
        "typescript": "~6.0.2",
        "vite": "^7.0.0",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11",
        "yaml": "^2.9.0"
    },
    "overrides": {
        "simple-git": "^4.0.2",
        "global-agent": "^4.1.3"
    },
    "packageManager": "npm@11.11.0",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "private": true,
    "build": {
        "appId": "com.phylla.app",
        "productName": "Phylla",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "package.json",
            "build/icon.png",
            {
                "from": "out",
                "to": "out",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "afterPack": "./build/afterPack.cjs",
        "extraResources": [
            "models/**",
            "assets/**"
        ],
        "asarUnpack": [
            "models/**",
            "node_modules/onnxruntime-node/**"
        ],
        "dmg": {
            "background": "build/dmg-background.png",
            "iconSize": 100,
            "iconTextSize": 14,
            "title": "${productName} ${version}",
            "contents": [
                {
                    "x": 180,
                    "y": 260
                },
                {
                    "x": 480,
                    "y": 260,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "mac": {
            "category": "public.app-category.productivity",
            "identity": null,
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "linux": {
            "executableName": "phylla",
            "target": [
                "AppImage",
                "deb",
                "rpm",
                "tar.gz"
            ],
            "category": "Utility",
            "maintainer": "Lorenzo Mazzola",
            "vendor": "Lorenzo Mazzola",
            "synopsis": "A local-first, privacy-focused note-taking app with on-device AI",
            "syncDesktopName": true
        }
    }
}
